{
  "keywords": [
    "# 一行一个敏感词；“原词=替换词”可指定代号；以 re: 开头为正则。下面是示例，用时请改成自己的",
    "某某花园=项目A",
    "某某置业=建设单位",
    "re:HC\\d{4}-[A-Z]+-\\d+"
  ],
  "whitelist": [
    "中国建筑标准设计研究院",
    "中国建筑工业出版社",
    "中国计划出版社",
    "住房和城乡建设部",
    "中华人民共和国住房和城乡建设部",
    "国家市场监督管理总局",
    "国家建筑标准设计",
    "中国建筑科学研究院有限公司建筑结构研究所"
  ],
  "options": {
    "titleblock_person": true,
    "titleblock_org": true,
    "titleblock_project": true,
    "titleblock_address": true,
    "titleblock_projno": true,
    "titleblock_cert": true,
    "titleblock_date": false,
    "detect_company": true,
    "detect_phone": true,
    "detect_email": true,
    "detect_idcard": true,
    "detect_uscc": true,
    "detect_account": true,
    "detect_url": true,
    "coord_text": false,
    "clean_metadata": true,
    "normalize_dates": true,
    "strip_paths": true,
    "remove_hyperlinks": true,
    "remove_thumbnail": true,
    "clear_signature_blocks": true,
    "rename_symbols": true,
    "remove_ole": false
